{
  "expo": {
    "name": "GPSn't",
    "slug": "gpsnt",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0D"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "package": "io.github.hueynemud.gpsnt",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Allow GPSn't to access motion sensors for navigation without GPS"
        }
      ],
      "./plugins/withMapAssets"
    ]
  }
}
